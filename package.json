{
  "name": "congedesk",
  "productName": "CongéDesk",
  "version": "1.0.0",
  "description": "Application Electron de gestion des congés et remplissage du formulaire CNAS GRH.22",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:x64": "electron-builder --win --x64",
    "build:ia32": "electron-builder --win --ia32 -c.electronVersion=43.2.0"
  },
  "keywords": [
    "cnas",
    "conge",
    "electron",
    "grh22"
  ],
  "author": "Mohamed",
  "license": "UNLICENSED",
  "build": {
    "appId": "com.congedesk.app",
    "productName": "CongéDesk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "db.js",
      "renderer/**/*",
      "resources/**/*",
      "assets/**/*",
      "data/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CongéDesk",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.3.4"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "pdf-lib": "^1.17.1"
  }
}
